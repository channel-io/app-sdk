                  },
                  "identifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "format": "uri"
                  },
                  "container": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["id", "name"],
                    "additionalProperties": false
                  },
                  "state": {
                    "$ref": "#/$defs/state"
                  },
                  "description": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": ["string", "null"],
                    "format": "date-time"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "closedAt": {
                    "type": ["string", "null"],
                    "format": "date-time"
                  },
                  "closedBy": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["user", "bot"]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1,
                            "format": "uri"
                          }
                        },
                        "required": ["name"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "providerState": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": ["string", "null"],
                        "minLength": 1
                      },
                      "category": {
                        "type": ["string", "null"],
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "issueId",
                  "identifier",
                  "title",
                  "url",
                  "state",
                  "providerState",
                  "createdAt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "required": false,
        "dependencies": ["extension.issue.core.getIssueTransitions"]
      }
    ]
  }
